     "data": {
      "text/markdown": [
       "$$\\begin{aligned}& h_{0}=200 \\ \\mathrm{m} \\\\ &  s_{k}=\\max\\left(\\frac{0.9 \\ \\mathrm{kN}}{\\mathrm{m}^{2}}, \\left(1 + \\left(\\frac{h_{0}}{350 \\ \\mathrm{m}}\\right)^{2}\\right) \\ 0.4 \\ \\mathrm{kN} \\ \\frac{1}{\\mathrm{m}^{2}}\\right)=\\frac{0.9 \\ \\mathrm{kN}}{\\mathrm{m}^{2}}\\end{aligned}$$"
      ],
      "text/plain": [
       "$$\\begin{aligned}& h_{0}=200 \\ \\mathrm{m} \\\\ &  s_{k}=\\max\\left(\\frac{0.9 \\ \\mathrm{kN}}{\\mathrm{m}^{2}}, \\left(1 + \\left(\\frac{h_{0}}{350 \\ \\mathrm{m}}\\right)^{2}\\right) \\ 0.4 \\ \\mathrm{kN} \\ \\frac{1}{\\mathrm{m}^{2}}\\right)=\\frac{0.9 \\ \\mathrm{kN}}{\\mathrm{m}^{2}}\\end{aligned}$$"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "h_0 = 200*m\n",
    "s_k = max((1 + (h_0 /(350*m))**2) * 0.4*kN/m**2, 0.9*kN/m**2)\n",
    "\n",
    "Cell()"
   ]
